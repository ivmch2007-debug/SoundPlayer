        <mxCell id="WIyWlLk6GJQsqaUBKTNV-1" parent="WIyWlLk6GJQsqaUBKTNV-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\n\ntitle SoundPlayer - UML Class Diagram\n\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam packageStyle rectangle\nhide empty members\n\npackage \&quot;model\&quot; {\n  class Song {\n    - id : String\n    - title : String\n    - artist : String\n    - durationSeconds : int\n    - mood : Mood\n    - style : String\n    - playable : boolean\n    - notes : List&lt;Note&gt;\n    + isPlayable() : boolean\n    + getNotes() : List&lt;Note&gt;\n  }\n\n  class Playlist {\n    - id : String\n    - name : String\n    - description : String\n    - mood : Mood\n    - songIds : List&lt;String&gt;\n    + addSong(songId : String) : boolean\n    + removeSong(songId : String) : boolean\n    + getSongIds() : List&lt;String&gt;\n  }\n\n  class Note {\n    - frequency : double\n    - durationMs : int\n    + getFrequency() : double\n    + getDurationMs() : int\n  }\n\n  enum Mood {\n    HAPPY\n    SAD\n    CALM\n    ENERGETIC\n    ROMANTIC\n  }\n}\n\npackage \&quot;dao\&quot; {\n  interface SongsDAO {\n    + getAllSongs() : ArrayList&lt;Song&gt;\n    + getSongById(id : String) : Song\n    + addSong(song : Song) : void\n    + deleteSong(id : String) : void\n  }\n\n  interface PlaylistsDAO {\n    + getAllPlaylists() : ArrayList&lt;Playlist&gt;\n    + getPlaylistById(id : String) : Playlist\n    + addPlaylist(playlist : Playlist) : void\n    + deletePlaylist(id : String) : void\n    + updatePlaylist(playlist : Playlist) : void\n  }\n\n  class JsonSongsDAO\n  class JsonPlaylistsDAO\n}\n\npackage \&quot;manager\&quot; {\n  class LibraryManager {\n    - songsDAO : SongsDAO\n    - playlistsDAO : PlaylistsDAO\n    + getAllSongs() : ArrayList&lt;Song&gt;\n    + addSong(song : Song) : void\n    + deleteSong(id : String) : void\n    + getAllPlaylists() : ArrayList&lt;Playlist&gt;\n    + createPlaylist(name : String) : Playlist\n    + addSongToPlaylist(playlistId : String, songId : String) : void\n    + removeSongFromPlaylist(playlistId : String, songId : String) : void\n    + getPlaylistDurationSeconds(playlistId : String) : int\n  }\n\n  interface NotePlayer {\n    + play(frequency : double, durationMs : int) : void\n  }\n\n  class PlaybackManager {\n    - library : LibraryManager\n    - notePlayer : NotePlayer\n    + getPlayableSongs() : ArrayList&lt;Song&gt;\n    + playSong(songId : String) : void\n    + playPlaylist(playlistId : String) : void\n  }\n\n  class AlbumGenerator {\n    - library : LibraryManager\n    + generateAlbum(mood : Mood, targetMinutes : int) : Playlist\n  }\n}\n\npackage \&quot;view\&quot; {\n  class ConsoleView {\n    - scanner : Scanner\n    + showMainMenu() : String\n    + showSongsMenu() : int\n    + showPlaylistsMenu() : int\n    + showPlaybackMenu() : int\n    + showSongs(songs : List&lt;Song&gt;) : void\n    + showPlaylists(playlists : List&lt;Playlist&gt;) : void\n    + readMood() : Mood\n    + showError(message : String) : void\n  }\n}\n\npackage \&quot;controller\&quot; {\n  class SoundPlayerController {\n    - view : ConsoleView\n    - library : LibraryManager\n    - playback : PlaybackManager\n    - albumGenerator : AlbumGenerator\n    + run() : void\n    - manageSongs() : void\n    - managePlaylists() : void\n    - managePlayback() : void\n    - generateRandomAlbum() : void\n  }\n}\n\npackage \&quot;audio\&quot; {\n  enum WaveType {\n    SINE\n    SQUARE\n    TRIANGLE\n    SAWTOOTH\n  }\n\n  abstract class Waveform {\n    + generate(phase : double) : double\n  }\n\n  class SineWave\n  class SquareWave\n  class TriangleWave\n  class SawtoothWave\n\n  class SoundSynth {\n    + makeSound(type : WaveType, frequency : int, durationMs : int) : void\n    - getWaveform(type : WaveType) : Waveform\n  }\n}\n\nclass Main {\n  + {static} main(args : String[]) : void\n}\n\nSong *-- Note\nSong --&gt; Mood\nPlaylist --&gt; Mood\nPlaylist ..&gt; Song : IDs\n\nJsonSongsDAO ..|&gt; SongsDAO\nJsonPlaylistsDAO ..|&gt; PlaylistsDAO\n\nLibraryManager --&gt; SongsDAO\nLibraryManager --&gt; PlaylistsDAO\nPlaybackManager --&gt; LibraryManager\nPlaybackManager --&gt; NotePlayer\nAlbumGenerator --&gt; LibraryManager\n\nSoundPlayerController --&gt; ConsoleView\nSoundPlayerController --&gt; LibraryManager\nSoundPlayerController --&gt; PlaybackManager\nSoundPlayerController --&gt; AlbumGenerator\n\nSineWave --|&gt; Waveform\nSquareWave --|&gt; Waveform\nTriangleWave --|&gt; Waveform\nSawtoothWave --|&gt; Waveform\nSoundSynth --&gt; Waveform\nSoundSynth --&gt; WaveType\n\nMain ..&gt; SoundPlayerController\nMain ..&gt; ConsoleView\nMain ..&gt; LibraryManager\nMain ..&gt; PlaybackManager\nMain ..&gt; AlbumGenerator\nMain ..&gt; SoundSynth\nMain ..&gt; JsonSongsDAO\nMain ..&gt; JsonPlaylistsDAO\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ydcrLpA2DF7MFXkFiXBr-0">
